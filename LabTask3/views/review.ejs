<body class="bg-light">
    <div class="container d-flex justify-content-center">
        <div class="progressheader">
      <ul class="mt-4 d-flex justify-content-center list-unstyled text-center gap-5">
        <li>
          <span
            class="d-inline-flex align-items-center justify-content-center border border-2 rounded-circle"
            style="width: 40px; height: 40px;  border: 2px solid #808d2b !important;">1</span>
          <div class="fw-medium mt-2">Cart</div>
        </li>
        <li>
          <span
            class="d-inline-flex align-items-center justify-content-center border border-2 rounded-circle"
            style="width: 40px; height: 40px;  border: 2px solid #808d2b !important;">2</span>
          <div class="fw-medium mt-2">Address</div>
        </li>
        <li>
          <span
            class="d-inline-flex align-items-center justify-content-center border border-2 rounded-circle"
            style="width: 40px; height: 40px; border: 2px solid #808d2b !important;">3</span>
          <div class="fw-medium mt-2">Payment</div>
        </li>
        <li>
          <span
            class="d-inline-flex align-items-center justify-content-center border border-2 rounded-circle text-white"
            style="width: 40px; height: 40px; background-color: #808d2b;   border: 2px solid #808d2b !important;">4</span>
          <div class="fw-medium mt-2">Review</div>
        </li>
      </ul>
    </div>
    </div>

    <div class="container col-md-5 mt-5">
        <div class="card shadow-sm">
            <div class="card-header text-white" style="background-color: #808d2b;">
                <h4 class="mb-0">Review Your Order</h4>
            </div>
            <div class="card-body">
                <h5>Shipping Details</h5>
                <p>
                    <strong>Name:</strong> <span id="reviewName"></span><br>
                    <strong>Address:</strong> <span id="reviewAddress"></span><br>
                    <strong>Phone:</strong> <span id="reviewPhone"></span>
                </p>

                <hr>

                <h5>Payment Method</h5>
                <p id="reviewPayment"></p>

                <hr>

                <h5>Order Summary</h5>
                <ul id="orderSummaryList" class="list-group mb-3">
                </ul>
                <ul class="list-group">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Subtotal
                        <span id="subtotal">$ 0</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Shipping
                        <span id="shipping">$ 0</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Tax (5%)
                        <span id="tax">$ 0</span>
                    </li>
                    <li
                        class="list-group-item d-flex justify-content-between align-items-center fw-bold border-top border-success">
                        Grand Total
                        <span id="grandTotal">$ 0</span>
                    </li>
                </ul>

            </div>
            <div class="text-center d-grid mt-4">
                <button id="placeOrderBtn" class="btn btn-lg" style="background-color: #808d2b;">Place Order</button>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>